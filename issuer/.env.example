# Prüfen Issuer — Environment Variables

# Shared secret for verifying requests come from the Prüfen backend
# Must match SECRET_KEY in the backend/.env
BACKEND_SECRET=dev-secret-key-change-in-production

# API key that backend/frontend must present in X-API-Key header
ISSUER_API_KEY=issuer-dev-key-change-in-production

# Port (default 8001 — must not conflict with backend on 8000)
PORT=8001

# Set to False in production
DEBUG=True
